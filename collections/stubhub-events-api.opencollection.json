          "http": {
            "method": "GET",
            "url": "https://api.stubhub.net/catalog/categories/:categoryId/events",
            "params": [
              {
                "name": "categoryId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.stubhub.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List events by category id."
        },
        {
          "info": {
            "name": "Get an event on the StubHub platform using an identifier from an external platform.",
            "type": "http"
          },
