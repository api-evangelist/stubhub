            "method": "GET",
            "url": "https://api.stubhub.net/catalog/events/external_mappings/:platform/:externalEventId",
            "params": [
              {
                "name": "platform",
                "value": "",
                "type": "path"
              },
              {
                "name": "externalEventId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.stubhub.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get an event on the StubHub platform using an identifier from an external platform."
        },
        {
          "info": {
            "name": "Get an event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stubhub.net/catalog/events/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.stubhub.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get an event"
        },
        {
          "info": {
            "name": "Search events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stubhub.net/catalog/events/search",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.stubhub.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Search events"
        },
        {
          "info": {
            "name": "Get all events under a CategoryId",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stubhub.net/catalog/categories/:categoryId/allevents",
            "params": [
              {
                "name": "categoryId",
