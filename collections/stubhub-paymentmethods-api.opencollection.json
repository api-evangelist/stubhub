{
  "opencollection": "1.0.0",
  "info": {
    "name": "StubHub Account Addressess PaymentMethods API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://account.stubhub.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "PaymentMethods",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List payment methods",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stubhub.net/paymentmethods",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.stubhub.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List payment methods"
        },
        {
          "info": {
            "name": "Get a payment method",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.stubhub.net/paymentmethods/:paymentMethodId",
            "params": [
              {
                "name": "paymentMethodId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.stubhub.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a payment method"
        },
        {
          "info": {
            "name": "List payment methods for a listing",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.stubhub.net/listings/:listingId/paymentmethods",
            "params": [
              {
                "name": "listingId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://account.stubhub.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List payment methods for a listing"
        }
      ]
    }
  ],
  "bundled": true
}